@@ -72,7 +77,15 @@ void I_SafeExit(int rc)
         }
     }
 
+#ifdef __ANDROID__
+    // Android packages Woof as SDLActivity's libmain.so. Return through
+    // SDL_main so the Java session boundary can atomically record the result
+    // before the dedicated game process is terminated.
+    i_android_exit_code = rc;
+    longjmp(i_android_exit_environment, 1);
+#else
     exit(rc);
+#endif
